# Copy this file to ".env" and fill in your real values.
# .env is git-ignored — never commit your real token.

DISCORD_TOKEN=your-bot-token-here

# Riot Games API 키 (롤 전적 조회 기능). https://developer.riotgames.com 에서 발급.
# 개발용 키(RGAPI-...)는 24시간마다 만료되니 만료되면 다시 발급받아 교체하세요.
RIOT_API_KEY=your-riot-api-key-here

# Groq API 키 (/ai 대화 기능, 무료·카드 불필요). https://console.groq.com/keys 에서 발급.
GROQ_API_KEY=your-groq-api-key-here
# 선택: 먼저 쓸 모델 (비우면 openai/gpt-oss-120b → llama-3.3-70b-versatile → llama-3.1-8b-instant)
GROQ_MODEL=

# Optional: set this to your test server (guild) ID for instant slash-command sync.
# Leave empty to sync globally (can take up to ~1 hour to appear).
GUILD_ID=
